storage/*
storage/chroma*/
storage/sqlite/*.db
storage/sqlite/*.sqlite
storage/sqlite/*.sqlite3
storage/demo/
*.db
*.sqlite
*.sqlite3

# logs
storage/logs/
*.log

# local model/cache files
models/
.ollama/
.cache/

# env
.env
.env.*
!.env.example

# python cache
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# temp
tmp/
temp/
.ipynb_checkpoints/

# OS / IDE
.DS_Store
Thumbs.db
